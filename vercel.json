{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/client",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/homes-for-sale",
      "destination": "/heritage-at-stonebridge-homes-for-sale",
      "permanent": true
    },
    {
      "source": "/floor-plans/:path*",
      "destination": "/floor-plans",
      "permanent": true
    },
    {
      "source": "/summerlin-55-plus",
      "destination": "/summerlin-55-plus-communities",
      "permanent": true
    },
    {
      "source": "/community",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/clubhouse",
      "destination": "/amenities",
      "permanent": true
    },
    {
      "source": "/pickleball",
      "destination": "/amenities",
      "permanent": true
    },
    {
      "source": "/lifestyle",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/location",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/questions",
      "permanent": true
    },
    {
      "source": "/downsizing",
      "destination": "/sell-heritage-at-stonebridge",
      "permanent": true
    },
    {
      "source": "/selling-guide",
      "destination": "/home-selling-guide",
      "permanent": true
    },
    {
      "source": "/buying-guide",
      "destination": "/buy-heritage-at-stonebridge",
      "permanent": true
    },
    {
      "source": "/market-update",
      "destination": "/market-reports",
      "permanent": true
    },
    {
      "source": "/home-valuation",
      "destination": "/sell-heritage-at-stonebridge",
      "permanent": true
    }
  ]
}
