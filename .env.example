# =============================================================================
# heritagestonebridge.com — Vercel Production env template
# Copy to .env.local for local dev. Never commit live secrets.
# =============================================================================

# Canonical site URL (must match Search Console property host)
NEXT_PUBLIC_BASE_URL=https://www.heritagestonebridge.com
# Alias read by lib/site-url.ts
NEXT_PUBLIC_SITE_URL=https://www.heritagestonebridge.com

# Google Search Console HTML tag verification (optional; DNS domain-property
# verification is preferred and covers all domains). Value = the content token
# Google/Bing give you; rendered as a <meta> tag site-wide in app/layout.tsx.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# RealScout — primary lead capture
NEXT_PUBLIC_REALSCOUT_URL=https://drjanduffy.realscout.com/
# Use the base64-encoded id (QWdlbnQtMjI1MDUw), NOT the plain numeric id (225050).
# If you set 225050 or Agent-225050, the app normalizes it at build time.
NEXT_PUBLIC_REALSCOUT_AGENT_ID=QWdlbnQtMjI1MDUw

# Calendly — secondary conversion (→ Follow Up Boss native)
NEXT_PUBLIC_CALENDLY_APPOINTMENT_URL=https://calendly.com/drjanduffy/appointment
NEXT_PUBLIC_CALENDLY_CONSULTATION_URL=https://calendly.com/drjanduffy/consultation

# Google Business Profile
# During GBP verification: NEXT_PUBLIC_GBP_REVIEWS_DISABLED=true
# After verification: set place ID from Google Place ID Finder
# NEXT_PUBLIC_GBP_PLACE_ID=ChIJ...
# NEXT_PUBLIC_GBP_WRITEREVIEW_URL=https://g.page/r/...
# Set only after GBP has verified reviews (enables aggregateRating JSON-LD + visible review counts)
# NEXT_PUBLIC_GBP_AGGREGATE_RATING_VALUE=4.9
# NEXT_PUBLIC_GBP_AGGREGATE_RATING_COUNT=200

# Google Maps (optional — Place-ID embed upgrade)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Follow Up Boss (server-only — Vercel env, never NEXT_PUBLIC_)
# FUB_API_KEY=
# FUB_SYSTEM_KEY=

# Anthropic / OpenRouter (optional AI features)
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Parallel Web Search (optional GEO/AEO excerpts — docs.parallel.ai)
# PARALLEL_API_KEY=

# Upstash rate limiting (optional)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Sentry (optional)
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile (optional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

NODE_ENV=development
